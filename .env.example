# ─────────────────────────────────────────────────────────────────────────────
# Émines de Rien — configuration template
#
# Copy to the real config and fill in. On OVH shared hosting there is no
# environment-variable mechanism, so this becomes a PHP file stored OUTSIDE the
# web root (see docs/02-ARCHITECTURE.md). Never commit the filled-in version.
#
# Anything left blank must cause a LOUD failure in production, never a silent
# fallback and never fake data (brief §21).
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
APP_ENV=development              # development | production
APP_URL=                         # e.g. https://eminesderien.be  (no trailing slash)
APP_DEFAULT_LOCALE=fr            # French is primary; never fall back to English

# ── Booking provider ─────────────────────────────────────────────────────────
# mock  = clearly-labelled development adapter, refuses to run in production
# beds24 = live
BOOKING_PROVIDER=mock

# ── Beds24 (API v2 — v1 is deprecated, do not use) ───────────────────────────
# Obtain in Beds24: (SETTINGS) MARKETPLACE > API.
# The invite code is exchanged ONCE for a refresh token; it expires after 24h.
# Scopes cannot be changed afterwards — a new invite code is required.
# Needs at least: read:inventory, read:properties, read:bookings, write:bookings
BEDS24_API_BASE=https://api.beds24.com/v2
BEDS24_INVITE_CODE=              # one-time, exchanged at setup then discard
BEDS24_REFRESH_TOKEN=            # long-lived; store after setup. SECRET.
BEDS24_PROPERTY_ID=
BEDS24_ROOM_ID=
BEDS24_OFFER_ID=1                # offer 1 is normally the standard offer

# Credit-based rate limit: 100 credits / 5 min by default. Caching is required,
# not optional. TTL in seconds.
BEDS24_CACHE_TTL=900

# ── Payments ─────────────────────────────────────────────────────────────────
# Beds24 creates the Stripe Checkout session via POST /channels/stripe using the
# owner's own Stripe account over Stripe Connect. Cards never reach this server
# and there is no PCI-DSS burden here. No Stripe secret key belongs in this file.
PAYMENT_PROVIDER=beds24_stripe
STRIPE_PUBLISHABLE_KEY=          # publishable only — never the secret key

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_ENABLED=true
ADMIN_SESSION_SECRET=            # long random string
ADMIN_PASSWORD_HASH=             # password_hash() output — never a plaintext password

# ── Storage (paths OUTSIDE the web root) ─────────────────────────────────────
CONTENT_PATH=../var/content
UPLOAD_PATH=../var/uploads
MAX_UPLOAD_MB=12

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Analytics (brief §9 — must not be hard-coded) ────────────────────────────
# Leave blank to load no analytics at all. Only loads after consent.
GA4_MEASUREMENT_ID=

# ── Social (brief §8 — a platform is hidden unless its URL is set) ───────────
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=

# ── Business facts rendered into all 7 locales ───────────────────────────────
CHECKIN_FROM=17:00
CHECKIN_UNTIL=20:00
CHECKOUT_BY=11:00
MAX_GUESTS=2
CURRENCY=EUR
EARLY_LATE_HOURLY_FEE=15         # €/hour, configurable (brief §2)
MAPS_DESTINATION=La Bruyère, Namur, Belgium   # area only — never the exact address

# ── Legal (brief §14 — TODO: supplied by owner, do not invent) ───────────────
LEGAL_BUSINESS_NAME=
LEGAL_ENTITY_NUMBER=             # BCE/KBO number
LEGAL_VAT_NUMBER=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
